[Unit]
Description=Integ Games leaderboard backend
After=network-online.target

[Service]
User=integ-games
Group=integ-games
WorkingDirectory=/opt/integ-games
EnvironmentFile=/etc/integ-games.env
ExecStart=/opt/integ-games/integ-games
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/integ-games

[Install]
WantedBy=multi-user.target
